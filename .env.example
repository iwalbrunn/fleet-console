# Copy to .env.local and adjust. .env.local is in .gitignore.

# Where the console looks for projects (separate several with :).
# An entry that is itself a Git repository counts as a single project,
# anything else is scanned one level deep.
FLEET_PROJECT_ROOTS=~/Developer

# Only needed if `claude` is not in the PATH
# FLEET_CLAUDE_BIN=/usr/local/bin/claude

# --- Role runs ---

# How many roles work at the same time.
FLEET_PIPELINE_PARALLEL=3

# Time limit per role in seconds (0 = none), then SIGTERM.
FLEET_ROLE_TIMEOUT_SEC=900

# Grace period between SIGTERM and SIGKILL, in seconds.
FLEET_GRACE_SEC=10

# Upper bound for the working state attached to every role task.
FLEET_DIFF_MAX=60000

# Model used when a role file does not specify one.
FLEET_PIPELINE_MODEL=sonnet

# Context window at which compaction kicks in.
FLEET_AUTOCOMPACT=200000
