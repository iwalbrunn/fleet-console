{
  "name": "fleet-console",
  "version": "0.1.0",
  "private": true,
  "description": "A local agent console for Claude Code — start sessions and watch them live, run roles as their own sessions, keep history and hooks in view",
  "license": "MIT",
  "author": "Ivan Walbrunn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iwalbrunn/fleet-console.git"
  },
  "scripts": {
    "dev": "next dev -p 4300 --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start -p 4300 --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.1",
    "next": "^15.5.4",
    "next-intl": "^4.13.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@next/eslint-plugin-next": "^15.5.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
