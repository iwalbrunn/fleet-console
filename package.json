{
  "name": "fleet-console",
  "version": "0.1.0",
  "private": true,
  "description": "A local Claude Code control room with external requirements, isolated worktrees, structured role reviews and history",
  "license": "MIT",
  "author": "Ivan Walbrunn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iwalbrunn/fleet-console.git"
  },
  "scripts": {
    "dev": "next dev -p 4300 --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start -p 4300 --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "overrides": {
    "postcss": ">=8.5.18"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.1",
    "next": "^16.3.2",
    "next-intl": "^4.13.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@next/eslint-plugin-next": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
